PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/lms_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email / SMTP (disabled until configured)
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=LMS

# SMS provider (disabled until configured)
SMS_ENABLED=false
SMS_PROVIDER_URL=https://smslenz.lk/api/send-sms
SMS_API_KEY=
SMS_USER_ID=
SMS_SENDER_ID=
SMS_DEFAULT_COUNTRY_CODE=94

# Uploads / invoice
MAX_FILE_SIZE_MB=10
INVOICE_DIR=./invoices
UPLOAD_DIR=./uploads

# Zoom Server-to-Server OAuth (optional)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_DEFAULT_DURATION_MINUTES=60
ZOOM_LEAD_MINUTES=15

# Telegram class-link scheduler (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
